{
  "manifest_version": 3,
  "name": "Messenger Message Hider",
  "version": "1.0",
  "description": "Blurs Messenger messages and sidebar. Hover to reveal.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.messenger.com/*",
        "https://www.facebook.com/messages/*",
        "https://chat.zalo.me/*"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
